# ============================================================
# AEGIS ULTIMATE ESPORTS BOT - Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to GitHub.
# ============================================================

# -------------------- Discord Bot --------------------
DISCORD_TOKEN=your_bot_token_here
DISCORD_OWNER_ID=your_discord_user_id_here
DISCORD_CLIENT_ID=your_application_client_id_here
DISCORD_CLIENT_SECRET=your_oauth_client_secret_here

# Optional: Development guild ID for faster slash command sync
# Leave empty for global sync (can take up to 1 hour)
DEV_GUILD_ID=

# -------------------- Dashboard / OAuth2 --------------------
# Must match the Redirect URI set in Discord Developer Portal
# Example for Railway: https://your-app-name.up.railway.app/callback
OAUTH_REDIRECT_URI=http://localhost:5000/callback

# Strong random secret used for Flask sessions (generate a long random string)
SESSION_SECRET=change_this_to_a_long_random_string_at_least_32_chars

# -------------------- Database --------------------
# On Railway: set this to the path on your persistent volume
# Example: /data/aegis.db
DATABASE_PATH=./data/aegis.db

# -------------------- Flask / Web Server --------------------
FLASK_ENV=production
FLASK_DEBUG=0
HOST=0.0.0.0
PORT=5000

# -------------------- Feature Flags (Global Defaults) --------------------
# These can be overridden per guild via the dashboard or owner commands
FEATURE_ESPORTS=true
FEATURE_SECURITY=true
FEATURE_MODERATION=true
FEATURE_STAFF=true
FEATURE_TICKETS=true
FEATURE_WELCOME=true
FEATURE_VERIFICATION=true
FEATURE_AUTOMOD=true
FEATURE_INVITES=true
FEATURE_COMMUNITY=true

# Disabled features (do not enable unless you implement them)
FEATURE_MUSIC=false
FEATURE_AI=false
FEATURE_LEVELING=false
FEATURE_ECONOMY=false

# -------------------- Logging --------------------
LOG_LEVEL=INFO
LOG_CHANNEL_ID=
SECURITY_LOG_CHANNEL_ID=

# -------------------- Bot Defaults --------------------
DEFAULT_PREFIX=&
DEFAULT_LANGUAGE=en
BOT_ACTIVITY_TYPE=watching
BOT_ACTIVITY_TEXT=Esports Tournaments | &help

# -------------------- Security Defaults --------------------
# Owner-only emergency controls
MAINTENANCE_MODE=false
